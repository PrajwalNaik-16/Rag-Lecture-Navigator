# ── Copy this to .env and fill in ONE llm key. Nothing else is required. ──

# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# ...or a free key from https://aistudio.google.com/apikey
# (Gemini's free tier is more generous than Groq's)
GEMINI_API_KEY=


# ── Everything below is optional ─────────────────────────────────────────

# Use this same collection name for local ingestion and the Render deployment.
YTRAG_COLLECTION=my_course_v2

# Optional: keep this project's transcripts and local index in its own folder.
# YTRAG_ROOT=.ytrag-my-course
# YTRAG_QDRANT_PATH=.ytrag-my-course/qdrant

# On a 4 GB GPU, these settings reduce Whisper memory use for long lessons.
# YTRAG_WHISPER_BATCH=1
# YTRAG_WHISPER_COMPUTE=int8_float16
# YTRAG_WHISPER_WINDOW_SECONDS=600

# Leave these blank and the vector index lives in a local folder
# (~/.ytrag/qdrant). Only set them if you want a hosted Qdrant cluster.
QDRANT_URL=
QDRANT_API_KEY=
# Request timeout in seconds for hosted Qdrant (default: 60).
# YTRAG_QDRANT_TIMEOUT_SECONDS=60

# groq | gemini | none   (auto-detected from whichever key you set above)
# YTRAG_LLM_BACKEND=

# Smaller + faster embedding model, if bge-m3 (2.2GB) is too heavy for your
# machine. Slightly worse on Hinglish, runs anywhere.
# YTRAG_EMBED_MODEL=all-MiniLM-L6-v2
# Set false on constrained hosts to defer model loading until the first request.
# YTRAG_PRELOAD_EMBEDDER=false
